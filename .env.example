# Copy to .env.local for a laptop. On Railway, set these in the service variables.
# Do not commit real values.

# Required in production. Friends type this on the join page.
# Development uses come-watch when this is unset.
INVITE_CODE=

# Required in production, at least 16 characters. Signs session cookies.
# Generate with: openssl rand -base64 32
# Development writes a random secret next to the database if this is unset.
SESSION_SECRET=

# Optional. On an empty database, creates this admin once. Later restarts do not
# reset the password. ADMIN_NAME defaults to ADMIN_USERNAME.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# Set to 1 to load the demo club (password reel-night) into an empty database.
# Unset or any other value does not seed.
SEED_DEMO=

# Directory for club.db. Production default is /data (the Railway volume).
# Development default is ./data. CLUB_DB_PATH overrides this with a full file path.
DATA_DIR=
CLUB_DB_PATH=

# Optional. Defaults to python3. movie_elo needs Python 3.9+.
PYTHON=

# Optional bcrypt cost, 4–15. Defaults to 12.
BCRYPT_ROUNDS=
