# Copy to .env.local for a real deploy. None of these belong in git.

# Shared secret friends type when they join. Required in production.
# Development falls back to come-watch when this is unset.
INVITE_CODE=

# Set to 1 to load the demo club into an empty database, including in production.
# Development seeds the demo unless this is 0.
SEED_DEMO=

# Optional. Defaults to data/club.db
CLUB_DB_PATH=

# Optional. Defaults to python3. movie_elo needs Python 3.9+.
PYTHON=

# Optional bcrypt cost, 4–15. Defaults to 12.
BCRYPT_ROUNDS=
